#include "core/sd_functions.h"
#include "core/utils.h"
#include "subghz/subghz_config.h"
#include "subghz/subghz_ui.h"
#include <esp_log.h>

static const char *TAG = "SubGhzUIOperations";

// Input handling implementations
void SubGhzUI::handleMainMenuInput() {
    if (check(UpPress)) {
        menu_index = (menu_index > 0) ? menu_index - 1 : main_menu_items.size() - 1;
        resetPressedButtons();
    }

    if (check(DownPress)) {
        menu_index = (menu_index < main_menu_items.size() - 1) ? menu_index + 1 : 0;
        resetPressedButtons();
    }

    if (check(SelPress)) {
        resetPressedButtons();

        switch (menu_index) {
            case 0: // Frequency Analyzer
                current_state = STATE_FREQUENCY_ANALYZER;
                menu_index = 0;
                startFrequencyAnalysis();
                break;

            case 1: // Signal Recorder
                current_state = STATE_SIGNAL_RECORDER;
                menu_index = 0;
                break;

            case 2: // Signal Player
                current_state = STATE_SIGNAL_PLAYER;
                menu_index = 0;
                loadSavedSignals();
                break;

            case 3: // Protocol Decoder
                current_state = STATE_PROTOCOL_DECODER;
                menu_index = 0;
                startProtocolDecoding();
                break;

            case 4: // Raw Capture
                current_state = STATE_RAW_CAPTURE;
                menu_index = 0;
                break;

            case 5: // Settings
                current_state = STATE_SETTINGS;
                menu_index = 0;
                break;

            case 6: // Exit
                is_running = false;
                break;
        }
    }

    if (check(EscPress)) {
        is_running = false;
        resetPressedButtons();
    }
}

void SubGhzUI::handleFrequencyAnalyzerInput() {
    if (check(SelPress)) {
        resetPressedButtons();

        if (receiver && subghz_receiver_is_running(receiver)) {
            stopFrequencyAnalysis();
        } else {
            startFrequencyAnalysis();
        }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        stopFrequencyAnalysis();
        current_state = STATE_MAIN_MENU;
        menu_index = 0;
    }

    // Frequency adjustment with up/down
    if (check(UpPress)) {
        resetPressedButtons();
        current_frequency += SUBGHZ_FREQUENCY_SCAN_STEP;
        if (current_frequency > SUBGHZ_FREQUENCY_SCAN_END) { current_frequency = SUBGHZ_FREQUENCY_SCAN_END; }

        // Update receiver frequency
        if (receiver) {
            SubGhzReceiverConfig config = {0};
            config.frequency = current_frequency;
            config.preset = current_preset;
            config.rssi_threshold = -80;
            subghz_receiver_configure(receiver, &config);
        }
    }

    if (check(DownPress)) {
        resetPressedButtons();
        current_frequency -= SUBGHZ_FREQUENCY_SCAN_STEP;
        if (current_frequency < SUBGHZ_FREQUENCY_SCAN_START) {
            current_frequency = SUBGHZ_FREQUENCY_SCAN_START;
        }

        // Update receiver frequency
        if (receiver) {
            SubGhzReceiverConfig config = {0};
            config.frequency = current_frequency;
            config.preset = current_preset;
            config.rssi_threshold = -80;
            subghz_receiver_configure(receiver, &config);
        }
    }
}

void SubGhzUI::handleSignalRecorderInput() {
    if (check(SelPress)) {
        resetPressedButtons();

        if (is_recording) {
            stopSignalRecording();
        } else {
            startSignalRecording();
        }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        if (is_recording) { stopSignalRecording(); }
        current_state = STATE_MAIN_MENU;
        menu_index = 1;
    }
}

void SubGhzUI::handleSignalPlayerInput() {
    if (saved_signals.empty()) {
        if (check(EscPress)) {
            resetPressedButtons();
            current_state = STATE_MAIN_MENU;
            menu_index = 2;
        }
        return;
    }

    if (check(UpPress)) {
        resetPressedButtons();
        menu_index = (menu_index > 0) ? menu_index - 1 : saved_signals.size() - 1;
    }

    if (check(DownPress)) {
        resetPressedButtons();
        menu_index = (menu_index < saved_signals.size() - 1) ? menu_index + 1 : 0;
    }

    if (check(SelPress)) {
        resetPressedButtons();
        if (menu_index < saved_signals.size()) { playSelectedSignal(); }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        current_state = STATE_MAIN_MENU;
        menu_index = 2;
    }
}

void SubGhzUI::handleProtocolDecoderInput() {
    if (check(SelPress)) {
        resetPressedButtons();

        if (receiver && subghz_receiver_is_running(receiver)) {
            stopProtocolDecoding();
        } else {
            startProtocolDecoding();
        }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        stopProtocolDecoding();
        current_state = STATE_MAIN_MENU;
        menu_index = 3;
    }
}

void SubGhzUI::handleRawCaptureInput() {
    if (check(SelPress)) {
        resetPressedButtons();

        if (receiver && subghz_receiver_is_running(receiver)) {
            stopRawCapture();
        } else {
            startRawCapture();
        }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        stopRawCapture();
        current_state = STATE_MAIN_MENU;
        menu_index = 4;
    }
}

void SubGhzUI::handleSettingsInput() {
    if (check(UpPress)) {
        resetPressedButtons();
        menu_index = (menu_index > 0) ? menu_index - 1 : settings_menu_items.size() - 1;
    }

    if (check(DownPress)) {
        resetPressedButtons();
        menu_index = (menu_index < settings_menu_items.size() - 1) ? menu_index + 1 : 0;
    }

    if (check(SelPress)) {
        resetPressedButtons();

        switch (menu_index) {
            case 0: // Frequency
                // TODO: Implement frequency selection dialog
                current_frequency += 1.0f;
                if (current_frequency > SUBGHZ_FREQUENCY_SCAN_END) {
                    current_frequency = SUBGHZ_FREQUENCY_SCAN_START;
                }
                break;

            case 1: // Preset
                current_preset = (SubGhzPreset)((current_preset + 1) % SubGhzPresetMax);
                break;

            case 2: // TX Power
                current_power += 5;
                if (current_power > 20) current_power = -30;
                break;

            case 3: // Load Defaults
                resetSettings();
                break;

            case 4: // Save Settings
                saveSettings();
                displayInfo("Settings saved");
                break;

            case 5: // Back
                current_state = STATE_MAIN_MENU;
                menu_index = 5;
                break;
        }
    }

    if (check(EscPress)) {
        resetPressedButtons();
        current_state = STATE_MAIN_MENU;
        menu_index = 5;
    }
}

// SubGHz operations implementations
void SubGhzUI::startFrequencyAnalysis() {
    if (!receiver) {
        ESP_LOGE(TAG, "Receiver not initialized");
        return;
    }

    ESP_LOGI(TAG, "Starting frequency analysis");

    // Configure receiver for analysis
    SubGhzReceiverConfig config = {0};
    config.frequency = current_frequency;
    config.preset = current_preset;
    config.rssi_threshold = -80;
    config.filter_enabled = false;
    config.raw_capture_enabled = false;

    if (!subghz_receiver_configure(receiver, &config)) {
        ESP_LOGE(TAG, "Failed to configure receiver");
        displayError("Failed to configure receiver");
        return;
    }

    // Set callback for frequency analysis
    subghz_receiver_set_callback(receiver, frequencyAnalysisCallback, this);

    // Start receiver
    if (!subghz_receiver_start(receiver)) {
        ESP_LOGE(TAG, "Failed to start receiver");
        displayError("Failed to start receiver");
        return;
    }

    // Clear previous results
    frequency_scan_results.clear();

    ESP_LOGI(TAG, "Frequency analysis started at %.2f MHz", current_frequency);
}

void SubGhzUI::stopFrequencyAnalysis() {
    if (receiver && subghz_receiver_is_running(receiver)) {
        subghz_receiver_stop(receiver);
        ESP_LOGI(TAG, "Frequency analysis stopped");
    }
}

void SubGhzUI::startSignalRecording() {
    if (!receiver) {
        ESP_LOGE(TAG, "Receiver not initialized");
        return;
    }

    ESP_LOGI(TAG, "Starting signal recording");

    // Configure receiver for recording
    SubGhzReceiverConfig config = {0};
    config.frequency = current_frequency;
    config.preset = current_preset;
    config.rssi_threshold = -70;
    config.filter_enabled = false;
    config.raw_capture_enabled = true;
    config.timeout_ms = MAX_RECORDING_DURATION_MS;

    if (!subghz_receiver_configure(receiver, &config)) {
        ESP_LOGE(TAG, "Failed to configure receiver for recording");
        displayError("Failed to configure receiver");
        return;
    }

    // Set raw callback for recording
    subghz_receiver_set_raw_callback(receiver, signalRecordingCallback, this);

    // Start receiver
    if (!subghz_receiver_start(receiver)) {
        ESP_LOGE(TAG, "Failed to start receiver for recording");
        displayError("Failed to start receiver");
        return;
    }

    is_recording = true;
    recording_start_time = millis();

    ESP_LOGI(TAG, "Signal recording started");
}

void SubGhzUI::stopSignalRecording() {
    if (receiver && subghz_receiver_is_running(receiver)) { subghz_receiver_stop(receiver); }

    if (is_recording) {
        is_recording = false;
        recording_duration = millis() - recording_start_time;

        ESP_LOGI(TAG, "Signal recording stopped after %d ms", recording_duration);

        // TODO: Save recorded signal to file
        String filename = "signal_" + String(millis()) + SUBGHZ_SIGNALS_EXTENSION;
        saveSignalToFile(filename);

        displayInfo("Signal saved as " + filename);
    }
}

void SubGhzUI::playSelectedSignal() {
    if (!transmitter || menu_index >= saved_signals.size()) {
        ESP_LOGE(TAG, "Invalid transmitter or signal index");
        return;
    }

    String signal_file = saved_signals[menu_index];
    ESP_LOGI(TAG, "Playing signal: %s", signal_file.c_str());

    // Load signal from file
    // TODO: Implement signal loading and transmission
    loadSignalFromFile(signal_file);

    // Configure transmitter
    SubGhzTransmitterConfig config = {0};
    config.frequency = current_frequency;
    config.preset = current_preset;
    config.tx_power = current_power;
    config.repeat = 1;
    config.gap_ms = 100;
    config.async_mode = true;

    if (!subghz_transmitter_configure(transmitter, &config)) {
        ESP_LOGE(TAG, "Failed to configure transmitter");
        displayError("Failed to configure transmitter");
        return;
    }

    // Set transmission callback
    subghz_transmitter_set_callback(transmitter, transmissionCallback, this);

    // TODO: Use actual signal data
    uint32_t test_signal[] = {500, 500, 250, 750, 500, 500, 250, 750};
    size_t signal_size = sizeof(test_signal) / sizeof(test_signal[0]);

    // Start transmission
    if (!subghz_transmitter_send_async(transmitter, test_signal, signal_size, 3)) {
        ESP_LOGE(TAG, "Failed to start transmission");
        displayError("Failed to start transmission");
        return;
    }

    ESP_LOGI(TAG, "Signal transmission started");
}

void SubGhzUI::startProtocolDecoding() {
    if (!receiver) {
        ESP_LOGE(TAG, "Receiver not initialized");
        return;
    }

    ESP_LOGI(TAG, "Starting protocol decoding");

    // Configure receiver for protocol detection
    SubGhzReceiverConfig config = {0};
    config.frequency = current_frequency;
    config.preset = current_preset;
    config.rssi_threshold = -75;
    config.filter_enabled = false;
    config.raw_capture_enabled = false;

    if (!subghz_receiver_configure(receiver, &config)) {
        ESP_LOGE(TAG, "Failed to configure receiver for protocol decoding");
        displayError("Failed to configure receiver");
        return;
    }

    // Set callback for protocol detection
    subghz_receiver_set_callback(receiver, protocolDecodingCallback, this);

    // Start receiver
    if (!subghz_receiver_start(receiver)) {
        ESP_LOGE(TAG, "Failed to start receiver for protocol decoding");
        displayError("Failed to start receiver");
        return;
    }

    detection_count = 0;
    last_detected_protocol = "";
    last_detected_data = "";

    ESP_LOGI(TAG, "Protocol decoding started");
}

void SubGhzUI::stopProtocolDecoding() {
    if (receiver && subghz_receiver_is_running(receiver)) {
        subghz_receiver_stop(receiver);
        ESP_LOGI(TAG, "Protocol decoding stopped");
    }
}

void SubGhzUI::startRawCapture() {
    if (!receiver) {
        ESP_LOGE(TAG, "Receiver not initialized");
        return;
    }

    ESP_LOGI(TAG, "Starting raw signal capture");

    // Configure receiver for raw capture
    SubGhzReceiverConfig config = {0};
    config.frequency = current_frequency;
    config.preset = current_preset;
    config.rssi_threshold = -80;
    config.filter_enabled = false;
    config.raw_capture_enabled = true;

    if (!subghz_receiver_configure(receiver, &config)) {
        ESP_LOGE(TAG, "Failed to configure receiver for raw capture");
        displayError("Failed to configure receiver");
        return;
    }

    // Set raw callback
    subghz_receiver_set_raw_callback(receiver, signalRecordingCallback, this);

    // Start receiver
    if (!subghz_receiver_start(receiver)) {
        ESP_LOGE(TAG, "Failed to start receiver for raw capture");
        displayError("Failed to start receiver");
        return;
    }

    ESP_LOGI(TAG, "Raw signal capture started");
}

void SubGhzUI::stopRawCapture() {
    if (receiver && subghz_receiver_is_running(receiver)) {
        subghz_receiver_stop(receiver);
        ESP_LOGI(TAG, "Raw signal capture stopped");
    }
}

// Callback implementations
void SubGhzUI::frequencyAnalysisCallback(void *context, SubGhzProtocolConfig *protocol_config) {
    if (!context || !protocol_config) return;

    SubGhzUI *ui = static_cast<SubGhzUI *>(context);

    // Add detection to scan results
    FrequencyData data;
    data.frequency = ui->current_frequency;
    data.rssi = subghz_receiver_get_rssi(ui->receiver);
    data.activity_count = 1;
    data.protocol_name = String(protocol_config->name);

    // Check if frequency already exists in results
    bool found = false;
    for (auto &result : ui->frequency_scan_results) {
        if (abs(result.frequency - data.frequency) < 0.1f) {
            result.activity_count++;
            if (data.rssi > result.rssi) {
                result.rssi = data.rssi;
                result.protocol_name = data.protocol_name;
            }
            found = true;
            break;
        }
    }

    if (!found && ui->frequency_scan_results.size() < 10) { ui->frequency_scan_results.push_back(data); }

    ESP_LOGI(
        TAG,
        "Frequency analysis: %.2f MHz, RSSI: %d dBm, Protocol: %s",
        data.frequency,
        data.rssi,
        data.protocol_name.c_str()
    );
}

void SubGhzUI::signalRecordingCallback(void *context, bool level, uint32_t duration) {
    if (!context) return;

    SubGhzUI *ui = static_cast<SubGhzUI *>(context);

    // TODO: Store signal data for later processing
    // For now, just log the signal
    ESP_LOGD(TAG, "Signal: %s %d us", level ? "HIGH" : "LOW", duration);
}

void SubGhzUI::protocolDecodingCallback(void *context, SubGhzProtocolConfig *protocol_config) {
    if (!context || !protocol_config) return;

    SubGhzUI *ui = static_cast<SubGhzUI *>(context);

    ui->detection_count++;
    ui->last_detected_protocol = String(protocol_config->name);

    // Format protocol data as hex string
    ui->last_detected_data = "";
    for (size_t i = 0; i < protocol_config->data_size && i < 32; i++) {
        char hex_byte[3];
        sprintf(hex_byte, "%02X", protocol_config->data[i]);
        ui->last_detected_data += hex_byte;
    }

    ESP_LOGI(
        TAG,
        "Protocol detected: %s, Data: %s",
        ui->last_detected_protocol.c_str(),
        ui->last_detected_data.c_str()
    );
}

void SubGhzUI::transmissionCallback(void *context, SubGhzTransmitterEvent event) {
    if (!context) return;

    SubGhzUI *ui = static_cast<SubGhzUI *>(context);

    switch (event) {
        case SUBGHZ_TRANSMITTER_EVENT_START: ESP_LOGI(TAG, "Transmission started"); break;

        case SUBGHZ_TRANSMITTER_EVENT_COMPLETE: ESP_LOGI(TAG, "Transmission completed"); break;

        case SUBGHZ_TRANSMITTER_EVENT_STOP: ESP_LOGI(TAG, "Transmission stopped"); break;

        case SUBGHZ_TRANSMITTER_EVENT_ERROR: ESP_LOGE(TAG, "Transmission error"); break;
    }
}

// File operations (placeholder implementations)
void SubGhzUI::saveSignalToFile(const String &filename) {
    // TODO: Implement signal file saving
    ESP_LOGI(TAG, "Saving signal to file: %s", filename.c_str());
}

void SubGhzUI::loadSignalFromFile(const String &filename) {
    // TODO: Implement signal file loading
    ESP_LOGI(TAG, "Loading signal from file: %s", filename.c_str());
}

void SubGhzUI::deleteSavedSignal(int index) {
    if (index >= 0 && index < saved_signals.size()) {
        String filename = saved_signals[index];
        saved_signals.erase(saved_signals.begin() + index);
        // TODO: Delete file from filesystem
        ESP_LOGI(TAG, "Deleted signal: %s", filename.c_str());
    }
}

void SubGhzUI::resetSettings() {
    current_frequency = SUBGHZ_DEFAULT_FREQUENCY;
    current_preset = SUBGHZ_DEFAULT_PRESET;
    current_power = SUBGHZ_DEFAULT_TX_POWER;
    ESP_LOGI(TAG, "Settings reset to defaults");
}
