case STATE_FREQUENCY_ANALYZER: drawFrequencyAnalyzer(); break;
case STATE_SIGNAL_RECORDER: drawSignalRecorder(); break;
case STATE_SIGNAL_PLAYER: drawSignalPlayer(); break;
case STATE_PROTOCOL_DECODER: drawProtocolDecoder(); break;
case STATE_RAW_CAPTURE: drawRawCapture(); break;
case STATE_SETTINGS: drawSettings(); break;
    }

    drawStatusBar();
