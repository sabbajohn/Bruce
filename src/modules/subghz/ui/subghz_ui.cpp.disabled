static const char *TAG = "SubGhzUI";

// Constructor
SubGhzUI::SubGhzUI()
    : _name("SubGHz"), current_state(STATE_MAIN_MENU), menu_index(0), is_running(false), subghz_core(nullptr),
      receiver(nullptr), transmitter(nullptr), current_frequency(433.92f),
      current_preset(SubGhzPreset2FSKDev476Async), current_power(10), is_recording(false),
      recording_start_time(0), recording_duration(0), detection_count(0) {
    initializeMenus();
    loadSettings();
}

// Destructor
SubGhzUI::~SubGhzUI() { cleanupSubGhz(); }

void SubGhzUI::optionsMenu() {
    if (!is_running) {
        initializeSubGhz();
        is_running = true;
    }

    showMainMenu();
}

void SubGhzUI::drawIcon(float scale) {
    // Draw SubGHz icon
    tft.drawRect(10 * scale, 10 * scale, 20 * scale, 10 * scale, TFT_WHITE);
    tft.drawLine(15 * scale, 5 * scale, 15 * scale, 15 * scale, TFT_WHITE);
    tft.drawLine(25 * scale, 5 * scale, 25 * scale, 15 * scale, TFT_WHITE);
}

void SubGhzUI::drawIconImg() {
    // For theme-based icon drawing
    drawIcon(1.0f);
}

bool SubGhzUI::getTheme() { return bruceConfig.theme.mode; }
