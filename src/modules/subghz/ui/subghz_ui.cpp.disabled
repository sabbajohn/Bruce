    // Static menu functions for main menu integration
    void SubGhzUI::subghz_frequency_analyzer_run() {
        SubGhzUI ui;
        ui.current_state = STATE_FREQUENCY_ANALYZER;
        ui.initializeSubGhz();
        ui.startFrequencyAnalysis();
        // Run frequency analyzer loop
    }

