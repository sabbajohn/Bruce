    // Utility methods
    String SubGhzUI::formatFrequency(float frequency) { return String(frequency, 2) + " MHz"; }

    String SubGhzUI::formatRSSI(int32_t rssi) { return String(rssi) + " dBm"; }

    String SubGhzUI::formatDuration(uint32_t duration_ms) {
        return String(duration_ms / 1000) + "." + String((duration_ms % 1000) / 100) + "s";
    }

    String SubGhzUI::getPresetName(SubGhzPreset preset) {
        switch (preset) {
            case SubGhzPresetOok270Async: return "OOK270";
            case SubGhzPresetOok650Async: return "OOK650";
            case SubGhzPreset2FSKDev238Async: return "2FSK238";
            case SubGhzPreset2FSKDev476Async: return "2FSK476";
            case SubGhzPresetMSK99_97KbAsync: return "MSK99";
            case SubGhzPresetGFSK9_99KbAsync: return "GFSK9";
            case SubGhzPresetCustom: return "Custom";
            default: return "Unknown";
        }
    }

    String SubGhzUI::getProtocolDescription(const String &protocol_name) {
        if (protocol_name == "Princeton") return "Princeton 24-bit";
        // Add more protocol descriptions as needed
        return protocol_name;
    }

