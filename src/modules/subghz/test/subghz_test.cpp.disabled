#include "subghz/subghz_test.h"
#include "subghz/subghz_config.h"
#include "subghz/subghz_core.h"
#include "subghz/subghz_ui.h"
#include <esp_log.h>
#include <freertos/FreeRTOS.h>
#include <freertos/task.h>

static const char *TAG = "SubGhzTest";

/**
 * @brief SubGHz system integration test
 *
 * Comprehensive test of all SubGHz components
 */

bool subghz_test_memory_system() {
    ESP_LOGI(TAG, "Testing memory system...");

    // Initialize memory
    if (!subghz_memory_init()) {
        ESP_LOGE(TAG, "Failed to initialize memory system");
        return false;
    }

    // Test allocation from each pool
    void *ptr1 = subghz_memory_alloc(SUBGHZ_MEMORY_POOL_PROTOCOL, 1024);
    void *ptr2 = subghz_memory_alloc(SUBGHZ_MEMORY_POOL_SIGNAL, 2048);
    void *ptr3 = subghz_memory_alloc(SUBGHZ_MEMORY_POOL_STRING, 512);
    void *ptr4 = subghz_memory_alloc(SUBGHZ_MEMORY_POOL_TEMP, 256);

    if (!ptr1 || !ptr2 || !ptr3 || !ptr4) {
        ESP_LOGE(TAG, "Memory allocation failed");
        return false;
    }

    // Free memory
    subghz_memory_free(SUBGHZ_MEMORY_POOL_PROTOCOL, ptr1);
    subghz_memory_free(SUBGHZ_MEMORY_POOL_SIGNAL, ptr2);
    subghz_memory_free(SUBGHZ_MEMORY_POOL_STRING, ptr3);
    subghz_memory_free(SUBGHZ_MEMORY_POOL_TEMP, ptr4);

    // Check integrity
    if (!subghz_memory_check_integrity(SUBGHZ_MEMORY_POOL_COUNT)) {
        ESP_LOGE(TAG, "Memory integrity check failed");
        return false;
    }

    ESP_LOGI(TAG, "Memory system test PASSED");
    return true;
}

bool subghz_test_core_system() {
    ESP_LOGI(TAG, "Testing core system...");

    // Create core
    SubGhzCore *core = subghz_core_create();
    if (!core) {
        ESP_LOGE(TAG, "Failed to create SubGHz core");
        return false;
    }

    // Get device
    SubGhzDevice *device = subghz_core_get_device(core);
    if (!device) {
        ESP_LOGE(TAG, "Failed to get SubGHz device");
        subghz_core_free(core);
        return false;
    }

    // Test device configuration
    if (!subghz_device_set_frequency(device, 433.92f)) {
        ESP_LOGE(TAG, "Failed to set frequency");
        subghz_core_free(core);
        return false;
    }

    if (!subghz_device_set_preset(device, SubGhzPreset2FSKDev476Async)) {
        ESP_LOGE(TAG, "Failed to set preset");
        subghz_core_free(core);
        return false;
    }

    if (!subghz_device_set_power(device, 10)) {
        ESP_LOGE(TAG, "Failed to set power");
        subghz_core_free(core);
        return false;
    }

    // Clean up
    subghz_core_free(core);

    ESP_LOGI(TAG, "Core system test PASSED");
    return true;
}

bool subghz_test_protocol_system() {
    ESP_LOGI(TAG, "Testing protocol system...");

    // Create protocol registry
    SubGhzProtocolRegistry *registry = subghz_protocol_registry_create();
    if (!registry) {
        ESP_LOGE(TAG, "Failed to create protocol registry");
        return false;
    }

    // Test protocol count
    size_t protocol_count = subghz_protocol_registry_get_count(registry);
    if (protocol_count == 0) {
        ESP_LOGE(TAG, "No protocols registered");
        subghz_protocol_registry_free(registry);
        return false;
    }

    ESP_LOGI(TAG, "Found %d registered protocols", (int)protocol_count);

    // Test protocol detection with sample data
    // Princeton test pattern: 101010101010101010101010 (24 bits)
    uint32_t princeton_signal[] = {
        400,
        1200, // Preamble
        400,
        400, // Bit 0
        400,
        1200, // Bit 1
        400,
        400, // Bit 0
        400,
        1200, // Bit 1
        400,
        400, // Bit 0
        400,
        1200, // Bit 1
        400,
        1200, // Sync
    };

    bool detected = false;
    for (size_t i = 0; i < sizeof(princeton_signal) / sizeof(princeton_signal[0]); i += 2) {
        bool level = (i / 2) % 2 == 0; // Alternate high/low
        uint32_t duration = princeton_signal[i];

        SubGhzProtocolConfig *result = subghz_protocol_registry_feed_data(registry, level, duration);
        if (result) {
            ESP_LOGI(TAG, "Protocol detected: %s", result->name);
            detected = true;
            break;
        }
    }

    // Clean up
    subghz_protocol_registry_free(registry);

    if (!detected) { ESP_LOGW(TAG, "No protocol detected (this may be normal for test data)"); }

    ESP_LOGI(TAG, "Protocol system test PASSED");
    return true;
}

bool subghz_test_transmitter_receiver() {
    ESP_LOGI(TAG, "Testing transmitter and receiver...");

    // Create core and get device
    SubGhzCore *core = subghz_core_create();
    if (!core) {
        ESP_LOGE(TAG, "Failed to create core for TX/RX test");
        return false;
    }

    SubGhzDevice *device = subghz_core_get_device(core);
    if (!device) {
        ESP_LOGE(TAG, "Failed to get device for TX/RX test");
        subghz_core_free(core);
        return false;
    }

    // Create transmitter
    SubGhzTransmitter *transmitter = subghz_transmitter_create(device);
    if (!transmitter) {
        ESP_LOGE(TAG, "Failed to create transmitter");
        subghz_core_free(core);
        return false;
    }

    // Create receiver
    SubGhzReceiver *receiver = subghz_receiver_create(device);
    if (!receiver) {
        ESP_LOGE(TAG, "Failed to create receiver");
        subghz_transmitter_free(transmitter);
        subghz_core_free(core);
        return false;
    }

    // Configure transmitter
    SubGhzTransmitterConfig tx_config = {0};
    tx_config.frequency = 433.92f;
    tx_config.preset = SubGhzPreset2FSKDev476Async;
    tx_config.tx_power = 0; // Low power for testing
    tx_config.repeat = 1;
    tx_config.gap_ms = 100;
    tx_config.async_mode = true;

    if (!subghz_transmitter_configure(transmitter, &tx_config)) {
        ESP_LOGE(TAG, "Failed to configure transmitter");
        subghz_receiver_free(receiver);
        subghz_transmitter_free(transmitter);
        subghz_core_free(core);
        return false;
    }

    // Configure receiver
    SubGhzReceiverConfig rx_config = {0};
    rx_config.frequency = 433.92f;
    rx_config.preset = SubGhzPreset2FSKDev476Async;
    rx_config.rssi_threshold = -80;
    rx_config.filter_enabled = false;
    rx_config.raw_capture_enabled = true;

    if (!subghz_receiver_configure(receiver, &rx_config)) {
        ESP_LOGE(TAG, "Failed to configure receiver");
        subghz_receiver_free(receiver);
        subghz_transmitter_free(transmitter);
        subghz_core_free(core);
        return false;
    }

    // Test state queries
    SubGhzTransmitterState tx_state = subghz_transmitter_get_state(transmitter);
    SubGhzReceiverState rx_state = subghz_receiver_get_state(receiver);

    ESP_LOGI(TAG, "Transmitter state: %d, Receiver state: %d", tx_state, rx_state);

    // Clean up
    subghz_receiver_free(receiver);
    subghz_transmitter_free(transmitter);
    subghz_core_free(core);

    ESP_LOGI(TAG, "Transmitter/Receiver test PASSED");
    return true;
}

bool subghz_test_ui_system() {
    ESP_LOGI(TAG, "Testing UI system...");

    // Create UI instance
    SubGhzUI ui;

    // Test UI name
    String name = ui.getName();
    if (name != "SubGHz") {
        ESP_LOGE(TAG, "UI name incorrect: %s", name.c_str());
        return false;
    }

    // Test drawing (just make sure it doesn't crash)
    ui.draw();

    ESP_LOGI(TAG, "UI system test PASSED");
    return true;
}

bool subghz_run_comprehensive_test() {
    ESP_LOGI(TAG, "Starting comprehensive SubGHz system test");
    ESP_LOGI(TAG, "SubGHz Module Version: %s", SUBGHZ_VERSION_STRING);

    bool all_tests_passed = true;

    // Test 1: Memory System
    if (!subghz_test_memory_system()) {
        ESP_LOGE(TAG, "Memory system test FAILED");
        all_tests_passed = false;
    }

    // Test 2: Core System
    if (!subghz_test_core_system()) {
        ESP_LOGE(TAG, "Core system test FAILED");
        all_tests_passed = false;
    }

    // Test 3: Protocol System
    if (!subghz_test_protocol_system()) {
        ESP_LOGE(TAG, "Protocol system test FAILED");
        all_tests_passed = false;
    }

    // Test 4: Transmitter/Receiver
    if (!subghz_test_transmitter_receiver()) {
        ESP_LOGE(TAG, "Transmitter/Receiver test FAILED");
        all_tests_passed = false;
    }

    // Test 5: UI System
    if (!subghz_test_ui_system()) {
        ESP_LOGE(TAG, "UI system test FAILED");
        all_tests_passed = false;
    }

    // Print memory statistics
    subghz_memory_print_stats();

    if (all_tests_passed) {
        ESP_LOGI(TAG, "🎉 ALL TESTS PASSED! SubGHz system is ready!");
    } else {
        ESP_LOGE(TAG, "❌ Some tests failed. Please check the implementation.");
    }

    return all_tests_passed;
}

void subghz_test_task(void *pvParameters) {
    ESP_LOGI(TAG, "SubGHz test task started");

    // Wait for system to stabilize
    vTaskDelay(pdMS_TO_TICKS(2000));

    // Run comprehensive test
    bool success = subghz_run_comprehensive_test();

    if (success) {
        ESP_LOGI(TAG, "SubGHz system initialization completed successfully");
    } else {
        ESP_LOGE(TAG, "SubGHz system initialization failed");
    }

    // Task complete
    vTaskDelete(NULL);
}

void subghz_start_test_task() {
    xTaskCreate(subghz_test_task, "subghz_test", 8192, NULL, tskIDLE_PRIORITY + 1, NULL);
}
